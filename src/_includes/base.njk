<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}: {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="preload" href="/fonts/chewy.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/atkinson-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/site.js" defer></script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="topbar-in">
      <a class="brand" href="/">{{ site.name }}</a>
      <nav aria-label="Site">
        <ul>
        {%- for item in nav %}{% if item.ready %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}{% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="footer-in">
      <p class="footer-brand">{{ site.name }}</p>
      <p>© 2026 {{ site.studio }}</p>
      <ul class="footer-links">
        {%- for item in nav %}{% if item.ready and item.url != "/" %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endif %}{% endfor %}
      </ul>
    </div>
  </footer>
</body>
</html>
