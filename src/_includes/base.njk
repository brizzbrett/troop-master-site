<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set fullTitle = title + " · " + site.name if title else "" %}
  <title>{% if title %}{{ fullTitle if fullTitle | length <= 70 else title }}{% else %}{{ site.name }}: {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {%- set pageTitle = (title + " · " + site.name) if title else (site.name + ": " + site.tagline) %}
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/brand/social-card.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="The {{ site.name }} wordmark on a parchment sign over a camp at dusk.">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png?v=neckerchief">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png?v=neckerchief">
  <link rel="preload" href="/fonts/chewy.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/atkinson-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} news" href="/news/feed.xml">
  <script src="/js/site.js" defer></script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="topbar-in">
      <a class="brand" href="/">{{ site.name }}</a>
      <nav aria-label="Site">
        <ul>
        {%- for item in nav %}{% if item.ready %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}{% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="footer-in">
      <p class="footer-brand">{{ site.name }}</p>
      <p>© 2026 {{ site.studio }}</p>
      <ul class="footer-links">
        {%- for item in nav %}{% if item.ready and item.url != "/" %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endif %}{% endfor %}
        <li><a href="/privacy/">Privacy</a></li>
        {%- if site.contactEmail %}<li><a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></li>{% endif %}
      </ul>
    </div>
  </footer>
</body>
</html>
