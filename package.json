{
  "name": "troop-master-site",
  "version": "0.1.0",
  "private": true,
  "description": "The official website for Troop Master.",
  "type": "module",
  "scripts": {
    "build": "eleventy && node tools/press-pack.mjs",
    "build:pages": "eleventy --pathprefix=/troop-master-site/ && node tools/press-pack.mjs",
    "start": "eleventy --serve",
    "brand": "node tools/brand.mjs",
    "check": "npm run build && node tools/check-links.mjs && html-validate \"_site/**/*.html\""
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "@11ty/eleventy-img": "6.0.4",
    "@11ty/eleventy-plugin-rss": "2.0.4",
    "@fontsource/atkinson-hyperlegible": "5.2.6",
    "@fontsource/chewy": "5.2.5",
    "fflate": "0.8.2",
    "html-validate": "11.16.0",
    "lighthouse": "13.5.0",
    "playwright": "1.55.0"
  }
}
